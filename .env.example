# ==============================================================================
# REPORT2026 SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_NAME='reportdb'
DB_USER='postgres'
DB_PASSWORD='your_db_password'
DB_HOST='localhost'
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
FRONTEND_URL='https://report.haophuong.com/'
BACKEND_URL='https://api-vending.haophuong.com'

# ------------------------------------------------------------------------------
# 3. GOOGLE SSO & AUTHENTICATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID='your_google_client_id.apps.googleusercontent.com'

# ------------------------------------------------------------------------------
# 4. EMAIL SMTP & NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER='your_email@gmail.com'
EMAIL_HOST_PASSWORD='your_16_digit_app_password'
DEFAULT_FROM_EMAIL='your_email@gmail.com'
EMAIL_DISPLAY_NAME='Hao Phuong Reporting System'
ADMIN_NOTIFICATION_EMAILS='admin1@haophuong.com, admin2@haophuong.com'

# ------------------------------------------------------------------------------
# 5. MISA AMIS AUTOMATION CONFIGURATION
# ------------------------------------------------------------------------------
MISA_AMIS_LOGIN_URL='https://amisapp.misa.vn/login/'
MISA_EMAIL='your_misa_account@haophuong.com'
MISA_PASSWORD='your_misa_password'
MISA_HEADLESS=True
MISA_BROWSER_CHANNEL='chrome'
MISA_EXPORT_SELECTOR="button:has-text('Xuất khẩu')"
USE_OPTION_EXPORT_REPORT_MISA=1
MISA_URL_REPORT_SAVED='https://actapp.misa.vn/app/RP/ReportSavedList'

# Report URLs
MISA_URL_BAN_HANG='https://actapp.misa.vn/app/SA/ReportAnalysis/RPDynamicViewer/SalesBookDetailDefault'
MISA_URL_MUA_HANG='https://actapp.misa.vn/app/PU/ReportAnalysis/RPDynamicViewer/PUDetailPurchaseByInventoryItemDynamic'
MISA_URL_TON_KHO='https://actapp.misa.vn/app/IN/ReportAnalysis/RPDynamicViewer/INInventoryBalanceSummary'
MISA_URL_CONG_NO_NCC='https://actapp.misa.vn/app/PU/ReportAnalysis/RPDynamicViewer/PUPayableSummaryBySupplier'
MISA_URL_TAI_KHOAN_CT='https://actapp.misa.vn/app/RP/ReportList/RPDynamicViewer/GLAccountLedger'
MISA_URL_TUOI_NO_KH='https://actapp.misa.vn/app/PU/ReportAnalysis/RPDynamicViewer/ReceivableDetailByDebtAge'
MISA_URL_BALISTOFBALANCE='https://actapp.misa.vn/app/BA/ReportAnalysis/RPDynamicViewer/BAListOfBalance'
MISA_EXCLUDED_BANK_ACCOUNTS='113611393939'

# ------------------------------------------------------------------------------
# 6. AUTOMATED DATA IMPORT SCHEDULE
# ------------------------------------------------------------------------------
IMPORT_SCHEDULE_TYPE='daily'
IMPORT_SCHEDULE_HOUR=07
IMPORT_SCHEDULE_MINUTE=00

# ------------------------------------------------------------------------------
# 7. AUTOMATED DEBT REMINDER EMAIL SCHEDULE & NOTIFICATION
# ------------------------------------------------------------------------------
# Công tắc tổng Bật/Tắt gửi mail tự động định kỳ (False = Tắt để an toàn)
AUTO_SEND_DEBT_REMINDERS_ENABLED=False

# Chế độ thử nghiệm (True = Dry-run không gửi mail thật; False = Gửi LIVE thật)
DEBT_REMINDER_DRY_RUN=True

# Email nhận mẫu thử nghiệm khi chạy dry-run (để trống nếu chỉ muốn xem thống kê)
DEBT_REMINDER_TEST_EMAIL='admin@haophuong.com'

# Đối tượng nhận: 'ALL' (Cả Sales & Trưởng BU), 'SALES' (Chỉ Sales), 'MANAGERS' (Chỉ Trưởng BU)
DEBT_REMINDER_RECIPIENT_TYPE='ALL'

# Giới hạn BU gửi (để trống = gửi toàn bộ 6 BU thương mại)
DEBT_REMINDER_BU_CODE=''

# Loại lịch biểu: 'weekly' (Mặc định), 'daily', 'monthly', 'custom'
DEBT_REMINDER_SCHEDULE_TYPE='weekly'
DEBT_REMINDER_SCHEDULE_HOUR=08
DEBT_REMINDER_SCHEDULE_MINUTE=00

# Ngày chạy trong tuần khi chọn 'weekly': '1' (Thứ 2), '1,4' (Thứ 2 & Thứ 5), '1-5' (Thứ 2 đến Thứ 6)
DEBT_REMINDER_SCHEDULE_DAY_OF_WEEK='1'

# Ngày chạy trong tháng khi chọn 'monthly': '1,15' (Ngày 1 và 15 hàng tháng)
DEBT_REMINDER_SCHEDULE_DAY_OF_MONTH='1,15'

# Chuỗi cron 5 trường khi chọn 'custom' (Ví dụ: 08:00 sáng Thứ Hai hàng tuần)
DEBT_REMINDER_SCHEDULE_CRON='0 8 * * 1'

